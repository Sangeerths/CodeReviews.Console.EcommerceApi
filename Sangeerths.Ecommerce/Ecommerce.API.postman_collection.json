{
  "info": {
    "name": "Ecommerce API",
    "description": "Postman collection for Category, Product, and Sale endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7146",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "saleId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Category",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Category?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Category"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Category By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Category/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Category", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sporting Goods\",\n  \"description\": \"Sports equipment and accessories\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Category",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Category"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sporting Goods Updated\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Category/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Category", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Category/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Category", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Product?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Product"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Product/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Product", "{{productId}}"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboard\",\n  \"description\": \"Mechanical keyboard, RGB backlight\",\n  \"price\": 79.99,\n  \"stockQuantity\": 30,\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Product",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Product"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboard Updated\",\n  \"description\": \"Mechanical keyboard, updated\",\n  \"price\": 89.99,\n  \"stockQuantity\": 25,\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Product/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Product", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Product/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Product", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Sale",
      "item": [
        {
          "name": "Get All Sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Sale?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Sale"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Sale By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Sale/{{saleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Sale", "{{saleId}}"]
            }
          }
        },
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice Johnson\",\n  \"saleDate\": \"2025-01-01T00:00:00\",\n  \"Items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 2,\n      \"unitPrice\": 999.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Sale",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Sale"]
            }
          }
        },
        {
          "name": "Update Sale",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice Johnson Updated\",\n  \"saleDate\": \"2025-01-02T00:00:00\",\n  \"Items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 3,\n      \"unitPrice\": 999.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Sale/{{saleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Sale", "{{saleId}}"]
            }
          }
        },
        {
          "name": "Delete Sale",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Sale/{{saleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Sale", "{{saleId}}"]
            }
          }
        }
      ]
    }
  ]
}
